# =====================================================================
# AVANYA LUXURY E-COMMERCE - ENVIRONMENT VARIABLES
# =====================================================================

# Environment
NODE_ENV=development

# Application URLs
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=AVANYA
NEXT_PUBLIC_CURRENCY_SYMBOL=₹

# NextAuth Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=super_secret_jwt_and_session_key_min_32_chars_long_123456

# Database
# For Local Dev (SQLite): file:./dev.db
# For Production (PostgreSQL): postgresql://postgres:password@localhost:5432/avanya_ecommerce?schema=public
DATABASE_URL="file:./dev.db"

# Razorpay Payments (Test Mode credentials from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId123
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere123
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret123

# Redis (Cache, BullMQ, Rate Limiting)
# Optional in dev; falls back to in-memory rate limiter / mock cache
REDIS_URL=redis://localhost:6379

# Email Service (Resend)
# Optional in dev; falls back to structured console logging
RESEND_API_KEY=re_123456789_mock_key
EMAIL_FROM="AVANYA Concierge <orders@avanya.in>"

# Admin Credentials
ADMIN_EMAIL=admin@avanya.in
