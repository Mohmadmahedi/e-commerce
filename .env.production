# =====================================================================
# AVANYA LUXURY E-COMMERCE - PRODUCTION CONFIGURATION FOR NETLIFY
# =====================================================================
NODE_ENV=production

# Database (Points to pre-seeded SQLite database in repository)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_URL="https://e-commerce-avanya.netlify.app"
NEXTAUTH_SECRET="avanya_super_secret_jwt_encryption_key_production_32chars"

# Store Info
NEXT_PUBLIC_APP_URL="https://e-commerce-avanya.netlify.app"
NEXT_PUBLIC_STORE_NAME="AVANYA"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# Razorpay Sandbox Keys (Replace with your live keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Admin & Communications
ADMIN_EMAIL="admin@avanya.in"
EMAIL_FROM="AVANYA Concierge <orders@avanya.in>"
